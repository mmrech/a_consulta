# Clinical Extractor - Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# ============================================================================
# GOOGLE GEMINI API KEY (REQUIRED)
# ============================================================================
# Get your API key from: https://ai.google.dev/
#
# This key is required for:
# - AI-powered PICO-T extraction
# - Summary generation
# - Metadata search with Google Search grounding
# - Table extraction with AI analysis
# - Image analysis with Gemini Vision
# - Deep analysis with extended thinking
# - Multi-agent medical research pipeline
#
# ⚠️ SECURITY WARNING: DEVELOPMENT/DEMO USE ONLY
# ================================================
# API keys set here are exposed in the compiled JavaScript bundle and visible
# in browser DevTools. This is acceptable for:
# - Local development environments
# - Personal projects and demos
# - Public applications with API key restrictions enabled
#
# For production deployments, you MUST:
# 1. Enable API key restrictions in Google Cloud Console:
#    - Set HTTP referrer restrictions (e.g., yourapp.com/*)
#    - Enable IP address restrictions if applicable
#    - Monitor usage and set up billing alerts
# 2. Consider implementing a backend proxy (see BACKEND_MIGRATION_PLAN.md)
# 3. Rotate API keys regularly (monthly recommended)
#
# Note: Both variables should have the same value for maximum compatibility
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
# Set to 'true' to skip AI tests that require real API calls
# Useful for running tests without consuming API quota
SKIP_AI_TESTS=false

# Set to 'true' to enable verbose test logging
VERBOSE_TESTS=false

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# Vite dev server port (default: 3000)
# PORT=3000

# ============================================================================
# PRODUCTION CONFIGURATION
# ============================================================================
# Base URL for production deployment
# BASE_URL=/

# ============================================================================
# OPTIONAL: BACKEND INTEGRATION
# ============================================================================
# Backend API URL (if using separate backend)
# VITE_BACKEND_URL=http://localhost:8000

# Backend API key (if backend requires authentication)
# VITE_BACKEND_API_KEY=your_backend_api_key_here

# ============================================================================
# BACKEND AUTHENTICATION (REQUIRED IF USING BACKEND)
# ============================================================================
# Default user credentials for automatic backend authentication
# These should be strong, unique credentials stored securely
# NEVER commit actual credentials to git
#
# SECURITY: Use a password manager to generate a strong password
# Example: openssl rand -base64 32
#
VITE_DEFAULT_USER_EMAIL=your_email@example.com
VITE_DEFAULT_USER_PASSWORD=generate_strong_password_here
